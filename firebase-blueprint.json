{
  "entities": {
    "ClassUpdate": {
      "title": "Class Update",
      "description": "Represents a status update for a specific class.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID for the class" },
        "name": { "type": "string", "description": "Name of the class (e.g., Math 101)" },
        "instructor": { "type": "string", "description": "Name of the instructor" },
        "status": { 
          "type": "string", 
          "enum": ["normal", "canceled", "delayed", "moved"],
          "description": "Current status of the class"
        },
        "details": { "type": "string", "description": "Additional details (e.g., new room number, delay duration)" },
        "dayOfWeek": { 
          "type": "string", 
          "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "description": "Day of the week the class occurs"
        },
        "time": { "type": "string", "description": "Time of the class" },
        "room": { "type": "string", "description": "Room number" },
        "duration": { "type": "string", "description": "Duration of the class" },
        "attendanceCode": { "type": "string", "description": "4-digit attendance code" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the status was last updated" },
        "updatedBy": { "type": "string", "description": "UID of the admin who updated the status" }
      },
      "required": ["name", "status", "dayOfWeek", "time"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user information and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "phoneNumber": { "type": "string" },
        "studentId": { "type": "string" }
      },
      "required": ["uid", "role"]
    },
    "Deadline": {
      "title": "Deadline",
      "description": "Represents an upcoming academic task.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["assignment", "test", "quiz", "meeting", "other"] },
        "dueDate": { "type": "string", "format": "date" },
        "course": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "dueDate"]
    },
    "ImportantDeadline": {
      "title": "Important Deadline",
      "description": "A mapping to mark a deadline as important for a specific user.",
      "type": "object",
      "properties": {
        "deadlineId": { "type": "string" },
        "markedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deadlineId"]
    },
    "SickLeave": {
      "title": "Sick Leave",
      "description": "A request for sick leave submitted by a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "reason": { "type": "string" },
        "type": { "type": "string", "enum": ["illness", "event"] },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "submittedAt": { "type": "string", "format": "date-time" },
        "adminComment": { "type": "string" }
      },
      "required": ["studentId", "reason", "startDate", "endDate", "status"]
    },
    "AttendanceRecord": {
      "title": "Attendance Record",
      "description": "A record of a student's attendance for a specific class.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string", "description": "UID of the student" },
        "studentId": { "type": "string", "description": "Academic ID of the student" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "deviceId": { "type": "string", "description": "Unique ID of the device used" }
      },
      "required": ["uid", "studentId", "studentName", "classId", "className", "timestamp"]
    },
    "AttendanceStats": {
      "title": "Attendance Stats",
      "description": "Daily attendance count for a specific class.",
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 0, "maximum": 5 }
      },
      "required": ["count"]
    },
    "DeviceLock": {
      "title": "Device Lock",
      "description": "Prevents multiple students from using the same device for attendance on the same day.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "studentId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "studentId", "timestamp"]
    }
  },
  "firestore": {
    "/classes/{classId}": {
      "schema": "ClassUpdate",
      "description": "Collection of class status updates."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and roles."
    },
    "/users/{userId}/important_deadlines/{deadlineId}": {
      "schema": "ImportantDeadline",
      "description": "User-specific important deadlines."
    },
    "/deadlines/{deadlineId}": {
      "schema": "Deadline",
      "description": "Upcoming academic deadlines."
    },
    "/sick_leaves/{leaveId}": {
      "schema": "SickLeave",
      "description": "Sick leave requests submitted by students."
    },
    "/attendance/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Attendance records signed by students."
    },
    "/attendance_stats/{statsId}": {
      "schema": "AttendanceStats",
      "description": "Daily attendance counts per class."
    },
    "/device_locks/{lockId}": {
      "schema": "DeviceLock",
      "description": "Locks a device to a specific user for a class on a specific day."
    }
  }
}
